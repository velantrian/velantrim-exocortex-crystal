{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velantrim.dev/schemas/trace.schema.json",
  "title": "Velantrim Answer Trace / Receipt",
  "description": "The two provenance artifacts the runtime actually emits: (1) the answer trace — the ordered list of trace items produced by core/trace.py build_trace() and returned in the pipeline result under 'trace'; (2) the sealed, replayable receipt produced by core/provenance.py build_receipt(). Both are verifiable offline without the LLM that phrased the answer. Receipts carry no separate receipt_id/trace_id: a receipt is identified and sealed by its content digest.",
  "oneOf": [
    {
      "$ref": "#/$defs/trace"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "trace": {
      "type": "array",
      "description": "Answer trace as emitted by core/trace.py build_trace(): one item per retrieved fact used to ground the answer.",
      "items": {
        "$ref": "#/$defs/trace_item"
      }
    },
    "trace_item": {
      "type": "object",
      "required": [
        "trace_version",
        "fact_id",
        "source",
        "origin",
        "epistemic_state",
        "retrieval_rank",
        "retrieval_score",
        "retrieval_signals",
        "retrieved_at"
      ],
      "additionalProperties": true,
      "properties": {
        "fact_id": {
          "type": "string",
          "description": "Identifier of the retrieved fact"
        },
        "source": {
          "type": "string",
          "description": "Human-readable origin label of the fact"
        },
        "origin": {
          "type": "string",
          "description": "How the fact entered this trace (e.g. retrieval / ingestion / volition)"
        },
        "epistemic_state": {
          "type": "string",
          "enum": [
            "Observed",
            "Hypothesized",
            "Supported",
            "Validated",
            "Contradicted",
            "Deprecated",
            "Collapsed",
            "ImmutableCore"
          ],
          "description": "ESM state of the fact at retrieval time (full list: core/memory.py ESM_STATES)"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_version": {
          "type": "integer",
          "const": 2
        },
        "retrieval_rank": {
          "type": "integer",
          "minimum": 1
        },
        "retrieval_score": {
          "type": "number",
          "description": "Query-local retrieval relevance score; never epistemic confidence"
        },
        "retrieval_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Query-local mechanisms that contributed to retrieval ordering"
        },
        "active_embedder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "stored_embedder_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval_config_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "projection_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "graph_explanation": {
          "type": "object",
          "description": "Bounded heuristic activation explanation; not evidence or proof",
          "additionalProperties": true
        }
      }
    },
    "receipt": {
      "type": "object",
      "description": "Sealed provenance receipt as emitted by core/provenance.py build_receipt() (RECEIPT_VERSION 2). The digest covers the sealed fields (version, created_at, query, answer, citations); 'signature' is present only when an HMAC key is configured.",
      "required": [
        "version",
        "created_at",
        "query",
        "answer",
        "citations",
        "digest"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Receipt format version (currently 2: embeds source-span evidence in citations when present)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "query": {
          "type": "string",
          "description": "The original user query"
        },
        "answer": {
          "type": "string",
          "description": "The attested answer. A blocked result (answer null) never produces a receipt."
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "digest": {
          "type": "string",
          "description": "Content digest over the sealed fields; identifies the receipt (there is no separate receipt_id)"
        },
        "signature": {
          "type": "string",
          "description": "Optional HMAC signature of the digest (present only when a signing key is configured)"
        }
      }
    },
    "citation": {
      "type": "object",
      "required": [
        "fact_id",
        "claim_sha256",
        "source",
        "epistemic_state",
        "truth_status"
      ],
      "additionalProperties": true,
      "properties": {
        "fact_id": {
          "type": "string"
        },
        "claim_sha256": {
          "type": "string",
          "description": "Hash of the cited claim text (content is not embedded in the receipt)"
        },
        "source": {
          "type": "string"
        },
        "epistemic_state": {
          "type": "string",
          "enum": [
            "Observed",
            "Hypothesized",
            "Supported",
            "Validated",
            "Contradicted",
            "Deprecated",
            "Collapsed",
            "ImmutableCore"
          ]
        },
        "truth_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "USER_CLAIMED",
            "UNVERIFIED",
            "HYPOTHESIS",
            "SUBJECTIVE"
          ]
        },
        "evidence": {
          "type": "array",
          "description": "Receipt v2: sealed source-span evidence attached to the cited fact (present only when spans exist)",
          "items": {
            "$ref": "#/$defs/evidence_span"
          }
        }
      }
    },
    "evidence_span": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_uri",
        "source_kind",
        "chunk_id",
        "span_start",
        "span_end",
        "source_sha256",
        "claim_sha256"
      ],
      "additionalProperties": true,
      "properties": {
        "evidence_id": {
          "type": "string"
        },
        "source_uri": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "chunk_id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 0
        },
        "source_sha256": {
          "type": "string"
        },
        "claim_sha256": {
          "type": "string"
        },
        "lineage_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "independence_class": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "SAME_LINEAGE",
            "INDEPENDENT_ASSERTED"
          ]
        },
        "lineage_basis": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "CURATOR_ASSERTED",
            "PUBLISHER_DECLARED",
            "IMPORTER_DECLARED"
          ]
        }
      }
    }
  }
}
